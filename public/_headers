# Corabin Studio — Security & Caching Headers
# Note: On Vercel, headers are configured via vercel.json (repo root).
# This file is provided for Netlify/Cloudflare Pages compatibility.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://framerusercontent.com; style-src 'self' 'unsafe-inline'; font-src 'self' data: https://framerusercontent.com; img-src 'self' data: blob: https://framerusercontent.com; media-src 'self' blob: https://video.gumlet.io; connect-src 'self' https://framerusercontent.com https://YOUR-N8N-WEBHOOK-URL; object-src 'none'; base-uri 'self'; form-action 'self' https://YOUR-N8N-WEBHOOK-URL; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/fonts.gstatic.com/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=86400
