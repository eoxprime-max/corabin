# Corabin Studio — Security & Caching Headers
# Note: On Vercel, headers are configured via vercel.json (repo root).
# This file is provided for Netlify/Cloudflare Pages compatibility.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://framerusercontent.com https://framer.com/m/phosphor-icons/; style-src 'self' 'unsafe-inline' https://unpkg.com; font-src 'self' data: https://framerusercontent.com https://fonts.gstatic.com; img-src 'self' data: blob: https://framerusercontent.com; media-src 'self' blob: https://video.gumlet.io; connect-src 'self' https://framerusercontent.com https://n8n.corabin.com; object-src 'none'; base-uri 'self'; form-action 'self' https://n8n.corabin.com; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/framerusercontent.com/*
  Cache-Control: public, max-age=31536000, immutable

/fonts.gstatic.com/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=86400
