    "LsyimjC_F": {
      "type": "string",
      "value": "Papyrus sought to reinvent traditional stationery for today's digital-first professionals who still cherish analog creative experiences. Our challenge was to design a brand and product line that bridges the gap between digital efficiency and tactile, meaningful communication."
    },
    "sXkke4r2E": {
      "type": "string",
      "value": "In an increasingly digital world, traditional stationery brands struggle to remain relevant, with most offerings feeling outdated and disconnected from contemporary work and creative practices. Papyrus needed a comprehensive redesign that would appeal to professionals who value both aesthetic quality and functional innovation in their writing and note-taking tools."
    },
    "c2uyRerVY": {
      "type": "responsiveimage",
      "value": {
        "src": "https://framerusercontent.com/images/lhKGKv70pkF3Fvrvf80p9sLVmM.jpg?width=1900&height=1425",
        "srcSet": "https://framerusercontent.com/images/lhKGKv70pkF3Fvrvf80p9sLVmM.jpg?scale-down-to=512&width=1900&height=1425 512w,https://framerusercontent.com/images/lhKGKv70pkF3Fvrvf80p9sLVmM.jpg?scale-down-to=1024&width=1900&height=1425 1024w,https://framerusercontent.com/images/lhKGKv70pkF3Fvrvf80p9sLVmM.jpg?width=1900&height=1425 1900w",
        "pixelWidth": 1900,
        "pixelHeight": 1425
      }
    },
    "POmBl6Cfz": {
      "type": "string",
      "value": "We developed a minimalist, modular stationery system that integrates seamlessly with digital workflows while celebrating the art of handwritten communication. Our design approach combined sustainable materials, ergonomic design, and a clean visual identity that speaks to professionals who appreciate both form and function, creating a product line that feels both cutting-edge and timeless."
    },
