    "LsyimjC_F": {
      "type": "string",
      "value": "Chantalle needed a brand identity that would help them stand out in the crowded clean beauty market. Our challenge was to create packaging and branding that would reflect their commitment to natural ingredients while maintaining a premium, sophisticated aesthetic."
    },
    "sXkke4r2E": {
      "type": "string",
      "value": "Despite having exceptional product formulations using rare natural ingredients, Chantalle's existing packaging and brand presence failed to convey the premium nature of their products. Their visual identity lacked the sophistication needed to justify their price point, and their packaging didn't effectively communicate their commitment to sustainability and natural ingredients."
    },
    "c2uyRerVY": {
      "type": "responsiveimage",
      "value": {
