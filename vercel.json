{
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://framerusercontent.com; style-src 'self' 'unsafe-inline' https://unpkg.com; font-src 'self' data: https://framerusercontent.com https://fonts.gstatic.com; img-src 'self' data: blob: https://framerusercontent.com; media-src 'self' blob: https://video.gumlet.io; connect-src 'self' https://framerusercontent.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ],
  "redirects": [
    { "source": "/projects/arrows", "destination": "/projects/kora", "statusCode": 301 },
    { "source": "/projects/chantalle", "destination": "/projects/himon", "statusCode": 301 },
    { "source": "/projects/papyrus", "destination": "/projects/norda", "statusCode": 301 },
    { "source": "/projects/london-museum", "destination": "/projects/ardene", "statusCode": 301 },
    { "source": "/projects/bullseye", "destination": "/projects/havyn", "statusCode": 301 },
    { "source": "/projects/interference", "destination": "/projects/almare", "statusCode": 301 }
  ],
  "rewrites": []
}
